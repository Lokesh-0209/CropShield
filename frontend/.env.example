# ==============================================================================
# CropShield Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' in the frontend/ directory:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Endpoint (FastAPI)
# ------------------------------------------------------------------------------
# Base URL where the CropShield FastAPI backend is running.
# Leave empty to use Vite proxy (/api -> http://localhost:8000) for zero-CORS development.
# Or set explicitly to http://localhost:8000.
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Mock Data Layer
# ------------------------------------------------------------------------------
# Set to 'true' to run fully standalone in browser memory with zero backend dependencies.
# The mock layer provides seeded Karnataka agriculture surveillance data:
# - Pre-loaded cases across Mandya, Hassan, Shimoga, Kolar, and Bagalkot
# - DBSCAN spatial outbreak clustering algorithms in pure JS
# - Simulated AI pathogen inference (Tomato Early Blight, Late Blight, Groundnut Leaf Spot, etc.)
# - Seeded sentinel queue and meteorological disease risk scores
VITE_USE_MOCK=false

# ------------------------------------------------------------------------------
# 3. Simulated Network Failure Rate (Resilience Testing)
# ------------------------------------------------------------------------------
# Probability (0.0 to 1.0) of simulated mock network errors.
# Useful for testing offline queues, error banners, toast notifications, and retry buttons.
# Default: 0.0 (no artificial errors)
# Recommended for testing error boundaries: 0.1 (10% random simulated drops)
VITE_MOCK_FAILURE_RATE=0.0
