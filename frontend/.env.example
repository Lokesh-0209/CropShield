# CropShield Frontend Environment Configuration Template

# Backend API Endpoint (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Enable Mock Data Layer (true = run with seeded Karnataka outbreak cases, clusters, & alerts)
VITE_USE_MOCK=true

# Optional simulated mock failure rate (0.0 = 0%, 0.1 = 10% network failures for error resilience testing)
VITE_MOCK_FAILURE_RATE=0.0
